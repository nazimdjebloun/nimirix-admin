
# -----------------------------------------------------------------------------
# CONVEX
# Used by: ConvexClientProvider, lib/auth-server.ts, convex/auth.ts
#
# Run `npx convex dev` to get these values. They are printed to the console
# and also written to .env.local automatically by the Convex CLI.
# -----------------------------------------------------------------------------

# The target Convex deployment (dev / prod).
# Format: <env>:<slug>  e.g. dev:wary-ox-539
CONVEX_DEPLOYMENT=dev:your-slug-here

# The HTTPS URL of your Convex deployment.
# Used by the React client and server-side auth helpers.
NEXT_PUBLIC_CONVEX_URL=https://your-slug-here.convex.cloud

# The "site" URL of your Convex deployment (ends in .convex.site).
# Used for Convex HTTP actions (e.g. Better Auth routes mounted in Convex).
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-slug-here.convex.site


# -----------------------------------------------------------------------------
# SITE URL
# Used by: convex/auth.ts (Better Auth baseURL)
#
# The public-facing URL of this Next.js app.
# In development this is typically http://localhost:3000.
# In production set it to your deployed domain, e.g. https://domain.com or https://cname.domain.com 
# -----------------------------------------------------------------------------

# Server-side only — NOT prefixed with NEXT_PUBLIC_.
# Better Auth uses this to build callback URLs and email links.
SITE_URL=http://localhost:3000

# Client-side alias (used by any client component that needs the site origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# BETTER AUTH
# Used by: convex/auth.ts
#
# Generate a secure secret with:  openssl rand -base64 32
# Keep this value private — rotating it will invalidate all active sessions.
# -----------------------------------------------------------------------------

BETTER_AUTH_SECRET=your-secret-here


# -----------------------------------------------------------------------------
# GMAIL (Nodemailer / Convex email action)
# Used by: lib/email/nodemailer.ts, convex/email.ts
#
# Uses a Gmail App Password — NOT your regular Gmail password.
# Steps to generate one:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create a new app password (name it "Nimirix Admin").
#   4. Paste the generated 16-character password below (spaces are optional).
# -----------------------------------------------------------------------------

# The Gmail address used as the "from" address for outgoing emails.
GMAIL_USER=you@gmail.com

# The 16-character App Password generated in the steps above.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
